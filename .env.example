# Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# Export from your wallet (e.g. MetaMask > Account details > Export Private Key).
POLYMARKET_PRIVATE_KEY=
# 0 = EOA/MetaMask (default), 1 = email/Magic wallet, 2 = browser proxy wallet
CLOB_SIGNATURE_TYPE=0
# Only needed for signature types 1/2 (proxy wallets) - your Polymarket proxy
# wallet address (Polymarket UI > profile > deposit address), not your EOA.
CLOB_FUNDER_ADDRESS=
# Not available from any UI - set POLYMARKET_PRIVATE_KEY (and
# CLOB_FUNDER_ADDRESS if needed) above, then run:
#   uv run python scripts/generate_api_creds.py
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Risk limits (USD)
MAX_POSITION_USD=100
MAX_ORDER_USD=25
MAX_DAILY_LOSS_USD=50
MAX_PORTFOLIO_EXPOSURE_USD=300
# Fraction of full Kelly actually staked (0.25 = quarter-Kelly)
KELLY_FRACTION=0.25

# Data layer
# Which markets to stream/persist/trade. Preferred: run
#   uv run python data/market_screener.py --write-tracked-markets
# which merges picks into TRACKED_MARKETS_PATH (tracked_markets.json) - if
# that file exists, it's used instead of MARKET_CONDITION_IDS below. Edit the
# file by hand to drop anything you don't want; it's never auto-removed from.
TRACKED_MARKETS_PATH=tracked_markets.json
# Fallback (used only if TRACKED_MARKETS_PATH doesn't exist): comma-separated
# condition_ids - look them up with scripts/find_market.py.
MARKET_CONDITION_IDS=
DB_PATH=polymarket_data.db
GAMMA_REFRESH_INTERVAL_SECONDS=300

# News edge signal
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
NEWS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NEWS_SIMILARITY_THRESHOLD=0.5
NEWS_MIN_PROBABILITY_SHIFT=0.03

# Misc
LOG_LEVEL=INFO

# DRY_RUN=true (default) logs every intended trade without submitting it.
# Going live requires BOTH of these set explicitly - see
# config.Settings.require_live_trading_confirmation().
DRY_RUN=true
LIVE_TRADING_CONFIRMED=false
